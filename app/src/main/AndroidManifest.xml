<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Necesario porque TmdbClient hace peticiones HTTP a api.themoviedb.org -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No hace falta mando táctil ni de verdad "leanback"; lo declaramos
         igualmente como no-requerido para que Google Play (si algún día se
         publica ahí) no descarte dispositivos TV. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <!-- Necesario en Android 11+ (package visibility) para poder comprobar
         si SmartTube está instalado y lanzarlo (YoutubeRedirect.kt), y para
         que StremioLauncher pueda dirigir explícitamente el Intent a Nuvio
         o Stremio. -->
    <queries>
        <package android:name="com.nuvio.app" />
        <package android:name="com.stremio.one" />
        <package android:name="com.teamsmart.videomanager.tv" />
        <package android:name="com.liskovsoft.smarttubetv" />
        <package android:name="org.smarttube.stable" />
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Sin esta categoría, la app queda instalada pero
                     invisible en la fila de apps del launcher de Android TV. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TvRecommendationAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <!-- El nombre correcto de este meta-data es "android.accessibilityservice"
                 (sin ".config"). Con el nombre equivocado, Android ignora
                 accessibility_service_config.xml por completo: la app queda
                 sin las capacidades declaradas ahí (canRetrieveWindowContent,
                 etc.), lo que en Android 14 se traduce en
                 "dumpsys accessibility" mostrando capabilities=0. -->
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
